<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Biosensor_pH.Controls"
             x:Class="Biosensor_pH.Controls.Chart"
             x:Name="this">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Label 
            x:Name="ChartTitle"
            Grid.Row="0"
            Text="Chart Title"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <GraphicsView
            x:Name="GraphicsView"
            Grid.Column="0"
            Grid.Row="1"/>
        
    </Grid>
</ContentView>
