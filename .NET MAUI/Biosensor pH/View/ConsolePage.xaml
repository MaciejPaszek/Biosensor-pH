<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModel="clr-namespace:Biosensor_pH.ViewModel"
             x:Class="Biosensor_pH.ConsolePage"
             x:DataType="viewModel:ConsoleViewModel"
             Title="Konsola"
>
    <ContentPage.BindingContext>
        <viewModel:ConsoleViewModel />
    </ContentPage.BindingContext>

    <Grid ColumnSpacing="10"
          RowSpacing="10"
          Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Picker
            Grid.Column="0"
            Grid.Row="0"
            ItemsSource="{Binding PortNames}"
            SelectedItem="{Binding PortName}"/>

        <Button
            Grid.Column="1"
            Grid.Row="0"
            Text="Odśwież"
            Command="{Binding ArduinoRefresh}"/>

        <Button
            Grid.Column="2"
            Grid.Row="0"
            Text="{Binding ButtonName}"
            Command="{Binding ArduinoConnect}"/>

        <Editor
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Grid.Row="1"
            AutoSize="TextChanges"
            FontFamily="Consolas"
            FontSize="16.0"
            IsReadOnly="True"
            Text="{Binding OutputString}"/> 

        <Entry
            Grid.Column="0"
            Grid.Row="2"
            Placeholder="Komenda"
            FontFamily="Consolas"
            FontSize="16.0"
            Text="{Binding CommandString}"
            ReturnCommand="{Binding ArduinoWrite}"/>

        <Button
            Grid.Column="1"
            Grid.Row="2"
            Text="Wyślij"
            Command="{Binding ArduinoWrite}"/>

        <Button
            Grid.Column="2"
            Grid.Row="2"
            Text="Wyczyść"
            Command="{Binding ArduinoClear}"/>
    </Grid>
</ContentPage>