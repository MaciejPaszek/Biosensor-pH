clear all
close all
clc

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Symulator Układu Chłodzącego
% (c) Maciej Paszek 2025
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Parametry symulatora
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

Tmin = 15;
Tmax = 25;
T   = 10;
h = 0.1;

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Parametry symulacji
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Liczba iteracji
N = 1000;

% Wymuszenie
u = zeros(N, 1);

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Zmienne symulacji
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

k = Tmax - Tmin;

y = zeros(N, 1);

yPrev = Tmax - Tmin;

x1 = 0;
x2 = 0;

for t = 1:N

    %  dx1
    % ----- = (k * u - x1) / T
    %  dt
    %
    %  dx2
    % ---- = (k * u - x1) / T
    %  dt
    %
    %    y = x2;
    %
    
    % Inercja I
    RHS1 = (0 - x1) / T
    
    % Inercja II
    RHS2 = (0 - x1) / T

    x1 = x1 + RHS1 * h;
    x2 = x2 + RHS2 * h;
    
    % Wyjście
    yNew = x2;

    y(t) = yNew;
    yPrev = yNew;
end

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Wykres
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

t = 1:N;

figure
plot(t, u, t, y);
xlabel("t, s");
ylabel("T, C");
legend(["u(t)", "y(t)"]);